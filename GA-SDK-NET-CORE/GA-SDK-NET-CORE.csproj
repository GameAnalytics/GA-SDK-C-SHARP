<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netcoreapp3.0</TargetFramework>
    <RootNamespace>GA_SDK_NET_CORE</RootNamespace>
    <AssemblyName>GameAnalytics.Net.Core</AssemblyName>
    <PackOnBuild>true</PackOnBuild>
    <PackageId>GameAnalytics.Net.Core.SDK</PackageId>
    <PackageVersion>3.4.0</PackageVersion>
    <Authors>GameAnalytics</Authors>
    <PackageIconUrl>http://public.gameanalytics.com/resources/images/sdk_doc/general/ga_logo_large.png</PackageIconUrl>
    <PackageLicenseUrl>https://opensource.org/licenses/MIT</PackageLicenseUrl>
    <Owners>GameAnalytics</Owners>
    <PackageProjectUrl>https://github.com/GameAnalytics/GA-SDK-C-SHARP</PackageProjectUrl>
    <PackageTags>gameanalytics</PackageTags>
    <Title>GameAnalytics .Net Core SDK</Title>
    <Description>GameAnalytics SDK for .Net Core 3.0</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="3.1.4" />
    <PackageReference Include="NLog" Version="4.7.2" />
    <!-- Security pins over vulnerable transitive dependencies. These are direct
         references only so NuGet resolves them ahead of the versions pulled in
         by Microsoft.EntityFrameworkCore.Sqlite; nothing in the SDK uses them
         directly.
         System.Text.Encodings.Web  CVE-2021-26701, transitively 4.7.1 via System.Text.Json.
         SQLitePCLRaw.bundle_e_sqlite3  CVE-2025-6965, transitively 2.0.2; 2.1.13 bundles SQLite 3.53.3. -->
    <PackageReference Include="System.Text.Encodings.Web" Version="4.7.2" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>
  <Import Project="..\GA-SDK-MONO-SHARED\GA-SDK-MONO-SHARED.projitems" Label="Shared" Condition="Exists('..\GA-SDK-MONO-SHARED\GA-SDK-MONO-SHARED.projitems')" />
</Project>
